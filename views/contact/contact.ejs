                </strong>

                <p>
                    Quick answers to your questions
                </p>
            </div>
        </div>
    </div>
</section>


<!-- contact -  form -->
<section class="contactform-section">
    <div class="contactform-container">

        <!-- =========================
             LEFT SIDE
        ========================== -->
        <div class="contact-left">
            <span class="contact-badge">
                Send a Message
            </span>

            <h1>Send Us a Message</h1>

            <p class="contact-intro">
                Fill out the form below and our team will get back to you within
                24-48 hours. We're here to answer any questions about our
                programs, camps, or enrollment.
            </p>

            <!-- form-container -->
            <div id="contactStateContainer">

                <div class="contact-form-card" id="contactFormCard">
                    <form id="contactForm" action="/home/contact" method="POST"
                        novalidate
                    >
                        <!-- Name + Phone -->
                        <div class="form-row">

                            <div class="form-group">
                                <label for="fullName">
                                    Full Name <span>*</span>
                                </label>
                                <input
                                    type="text"
                                    id="fullName"
                                    name="fullName"
                                    placeholder="Your full name"
                                    autocomplete="name"
                                    maxlength="100"
                                    required
                                >
                                <small class="field-error" id="fullNameError"></small>
                            </div>


                            <div class="form-group">
                                <label for="phone">
                                    Phone Number <span>*</span>
                                </label>
                                <input
                                    type="tel"
                                    id="phone"
                                    name="phone"
                                    placeholder="+91 XXXXX XXXXX"
                                    autocomplete="tel"
                                    maxlength="20"
                                >
                                <small class="field-error" id="phoneError"></small>
                            </div>
                        </div>

                        
                        <!-- Email -->
                        <div class="form-group">

                            <label for="email">
                                Email Address <span>*</span>
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="your@email.com"
                                autocomplete="email"
                                maxlength="150"
                                required
                            >

                            <small class="field-error" id="emailError"></small>
                        </div>


                        <!-- Subject -->
                        <div class="form-group">
                            <label for="subject">
                                Subject <span>*</span>
                            </label>

                            <input
                                type="text"
                                id="subject"
                                name="subject"
                                placeholder="What is this regarding?"
                                maxlength="200"
                                required
                            >

                            <small class="field-error" id="subjectError"></small>
                        </div>


                        <!-- Message -->
                        <div class="form-group">
                            <label for="message">
                                Message <span>*</span>
                            </label>

                            <textarea
                                id="message"
                                name="message"
                                placeholder="Tell us more about your inquiry..."
                                maxlength="5000"
                                required
                            ></textarea>

                            <div class="message-footer">
                                <small class="field-error" id="messageError"></small>

                                <span class="character-count">
                                    <span id="messageCount">0</span>/5000
                                </span>
                            </div>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="contact-submit-btn" id="contactSubmitBtn">
                            <span
                                class="submit-icon"
                                id="submitIcon"
                            >
                                ➤
                            </span>

                            <span id="submitText">
                                Send Message
                            </span>
                        </button>
                    </form>
                </div>

                <!-- ===================================================
                    SUCCESS STATE
                ====================================================== -->
                <div
                    class="contact-form-card contact-result-card"
                    id="contactSuccessCard" hidden
                >
                    <div class="result-icon result-success-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <h2>Thank You!</h2>

                    <p>
                        Your message has been received.
                        We'll get back to you within 24-48 hours.
                    </p>
                </div>


                <!-- =====================================================
                    ERROR STATE
                ====================================================== -->
                <div
                    class="contact-form-card contact-result-card"
                    id="contactErrorCard"
                    hidden
                >
                    <div class="result-icon result-error-icon">
                        <i class="fa-solid fa-circle-exclamation"></i>
                    </div>

                    <h2>Something Went Wrong</h2>

                    <p>
                        We couldn't send your message right now.
                        Please try again.
                    </p>

                </div>
            </div>
        </div>

            
        <!-- =========================
             RIGHT SIDE
        ========================== -->
        <div class="contact-right">

            <span class="contact-badge contact-badge-blue">
                Contact Details
            </span>
            <h2>Get in Touch</h2>
            <p class="contact-intro">
                Reach out through any of these channels. Our friendly team is
                ready to help you find the perfect program for your child.
            </p>

            <!-- Email -->
            <div class="contact-info-card">
                <div class="info-icon email-icon">
                    <i class="fa-solid fa-envelope"></i>
                </div>

                <div class="info-content">
                    <h3>Email Us</h3>
                    <a href="mailto:info@fit5sportsclub.in">
                        info@fit5sportsclub.in
                    </a>
                    <p>
                        We typically respond within 24 hours
                    </p>
                </div>
            </div>

            <!-- Phone -->
            <div class="contact-info-card">
                <div class="info-icon phone-icon">
                    <i class="fa-solid fa-phone"></i>
                </div>

                <div class="info-content">
                    <h3>Call Us</h3>
                    <strong>Available on request</strong>
                    <p>
                        Monday - Saturday, 9:00 AM - 6:00 PM IST
                    </p>
                </div>
            </div>

            <!-- Location -->
            <div class="contact-info-card">
                <div class="info-icon location-icon">
                    <i class="fa-solid fa-location-dot"></i>
                </div>

                <div class="info-content">
                    <h3>Location</h3>
                    <strong>India</strong>
                    <p>
                        Multiple locations across India
                    </p>
                </div>
            </div>

            <!-- Office Hours -->
            <div class="office-hours-card">
                <div class="office-title">
                    <div class="office-title-icon">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <h3>Office Hours</h3>
                </div>

                <div class="office-row">
                    <div>
                        <span class="calendar-icon"><i class="fa-regular fa-calendar"></i></span>
                        Monday - Friday
                    </div>

                    <strong>
                        9:00 AM - 6:00 PM
                    </strong>
                </div>

                <div class="office-row">
                    <div>
                        <span class="calendar-icon"><i class="fa-regular fa-calendar"></i></span>
                        Saturday
                    </div>
                    <strong>
                        9:00 AM - 2:00 PM
                    </strong>
                </div>

                <div class="office-row">
                    <div class="closed-row">
                        <span class="calendar-icon"><i class="fa-regular fa-calendar"></i></span>
                        Sunday
                    </div>

                    <strong class="closed-text">
                        Closed
                    </strong>
                </div>
            </div>
        </div>
    </div>
</section>



