<!-- =========================================
     FAQ SECTION
========================================= -->
<section class="contact-faq-section">

    <div class="contact-faq-container">

        <!-- HEADER -->
        <div class="contact-faq-header">

            <span class="contact-faq-badge">
                FAQ
            </span>

            <h2>Frequently Asked Questions</h2>

            <p>
                Quick answers to the questions we hear most often
            </p>

        </div>


        <!-- FAQ LIST -->
        <div class="contact-faq-list">

            <!-- FAQ ITEM 1 -->
            <div class="contact-faq-item active">

                <button class="contact-faq-question" type="button">
                    <span>
                        How do I enroll my child in a program?
                    </span>

                    <i class="fa-solid fa-chevron-down"></i>
                </button>

                <div class="contact-faq-answer">
                    <p>
                        Contact us via email or phone to discuss your interests and goals. We'll help you choose the right program and guide you through the enrollment process. You can also visit our Registration page to get started.
                    </p>
                </div>

            </div>


            <!-- FAQ ITEM 2 -->
            <div class="contact-faq-item">

                <button class="contact-faq-question" type="button">
                    <span>
                        Are your programs suitable for beginners?
                    </span>

                    <i class="fa-solid fa-chevron-down"></i>
                </button>

                <div class="contact-faq-answer">
                    <p>
                       Absolutely! We offer programs for all skill levels, from complete beginners to advanced athletes. Our coaches will tailor the training to your child's current fitness level and goals.
                    </p>
                </div>

            </div>


            <!-- FAQ ITEM 3 -->
            <div class="contact-faq-item">

                <button class="contact-faq-question" type="button">
                    <span>
                        What safety measures do you have in place?
                    </span>

                    <i class="fa-solid fa-chevron-down"></i>
                </button>

                <div class="contact-faq-answer">
                    <p>
                        Safety is our top priority. We have trained medical staff, comprehensive insurance coverage, 24/7 supervision at residential camps, and all our coaches are certified in first aid and CPR.
                    </p>
                </div>

            </div>


            <!-- FAQ ITEM 4 -->
            <div class="contact-faq-item">

                <button class="contact-faq-question" type="button">
                    <span>
                        Do you offer programs for children with disabilities?
                    </span>

                    <i class="fa-solid fa-chevron-down"></i>
                </button>

                <div class="contact-faq-answer">
                    <p>
                        Yes, we have specialized adaptive sports programs designed for individuals with various disabilities. Our trained staff ensure an inclusive, supportive environment for all participants.
                    </p>
                </div>

            </div>


            <!-- FAQ ITEM 5 -->
            <div class="contact-faq-item">

                <button class="contact-faq-question" type="button">
                    <span>
                        What is the typical duration of your camps?
                    </span>

                    <i class="fa-solid fa-chevron-down"></i>
                </button>

                <div class="contact-faq-answer">
                    <p>
                        Our residential summer camps range from 1 to 4 weeks. We also offer year-round club training programs with flexible scheduling, including weekend and after-school options.
                    </p>
                </div>

            </div>


            <!-- FAQ ITEM 6 -->
            <div class="contact-faq-item">

                <button class="contact-faq-question" type="button">
                    <span>
                        Can parents visit during residential camps?
                    </span>

                    <i class="fa-solid fa-chevron-down"></i>
                </button>

                <div class="contact-faq-answer">
                    <p>
                        Yes! We organize scheduled family visit days during residential camps. We also provide regular updates and photos so parents stay connected with their child's camp experience.
                    </p>
                </div>

            </div>

        </div>

    </div>

</section>



