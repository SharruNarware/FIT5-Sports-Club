<% layout("/layouts/layout") %>

<section class="show-page">
    <div class="show-container">

        <div class="show-topbar">
            <div class="show-back">
               <a href="/home/blogs" class="show-back-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Back to Blogs</span>
                </a>
            </div>

            <div class="show-actions">
                <a href="/home/blogs/<%= blog._id %>/edit"
                    class="show-edit-btn">
                    <i class="fa-solid fa-pen"></i>
                </a>

                <form
                    action="/home/blogs/<%= blog._id %>?_method=DELETE"
                    method="POST">
                    <button class="show-delete-btn">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </form>
            </div>
        </div>

        <a class="show-topic">
            <%= blog.topic %>
        </a>

        <h1 class="show-title">
            <%= blog.title %>
        </h1>

        <div class="show-meta">
            <span>
                <i class="fa-regular fa-user"></i>
                Fit5 Sports Club
            </span>

            <span>
                <i class="fa-regular fa-calendar"></i>
                <%= blog.createdAt.toLocaleDateString(
                'en-US',
                {
                    month:'long',
                    day:'numeric',
                    year:'numeric'
                }) %>
            </span>

            <span>
                <i class="fa-regular fa-clock"></i>
                <%= blog.readTime %> min read
            </span>
        </div>

        <div class="show-image">
            <img
                src="<%= blog.image %>"
                alt="<%= blog.title %>">
        </div>

        <h1 class="show-title-content">
            <%= blog.title %>
        </h1>

        <p class="show-description">
            <%= blog.description %>
        </p>

        <div class="show-content">
            <%- blog.content %>
        </div>

        <div class="show-tags-section">
            <h3>Tags :</h3>
            <div class="show-tags">
                <% blog.tags.forEach(tag=>{ %>
                    <span>
                        <%= tag %>
                    </span>
                <% }) %>
            </div>
        </div>
    </div>
</section>