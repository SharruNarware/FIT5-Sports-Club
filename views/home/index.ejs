                    </div>

                    <span class="step-number">
                        01
                    </span>
                </div>

                <h3>
                    Reach Out
                </h3>

                <p>
                    Contact us to discuss your child's needs,
                    interests, and goals with our friendly team
                </p>
            </div>


            <!-- STEP 2 -->
            <div class="step">
                <div class="step-icon-wrapper">
                    <div class="step-icon">
                        <i class="fa-solid fa-bullseye"></i>
                    </div>

                    <span class="step-number">
                        02
                    </span>
                </div>

                <h3>
                    Get Matched
                </h3>

                <p>
                    We'll recommend the perfect program —
                    camp, training, or adaptive — based on your
                    child's profile
                </p>
            </div>

            <!-- STEP 3 -->
            <div class="step">
                <div class="step-icon-wrapper">
                    <div class="step-icon">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>

                    <span class="step-number">
                        03
                    </span>
                </div>

                <h3>
                    Register
                </h3>

                <p>
                    Complete a simple registration process and
                    secure your child's spot in their chosen
                    program
                </p>
            </div>

            <!-- STEP 4 -->
            <div class="step">
                <div class="step-icon-wrapper">
                    <div class="step-icon">
                        <i class="fa-solid fa-trophy"></i>
                    </div>

                    <span class="step-number">
                        04
                    </span>
                </div>

                <h3>
                    Thrive
                </h3>

                <p>
                    Your child trains, grows, and flourishes in a
                    safe, inclusive, and supportive environment
                </p>
            </div>
        </div>
    </div>
</section>



