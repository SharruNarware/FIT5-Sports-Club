<!-- =========================================================
     OUR TRAINING PHILOSOPHY
     ========================================================= -->

<section class="training-philosophy-section">

    <div class="training-philosophy-container">

        <!-- SECTION HEADER -->
        <div class="training-philosophy-header">

            <span class="training-philosophy-badge">
                How We Coach
            </span>

            <h2>Our Training Philosophy</h2>

            <p>
                The principles that guide our coaching methodology and shape every training session
            </p>

        </div>


        <!-- PHILOSOPHY CARDS -->
        <div class="training-philosophy-grid">

            <!-- Card 1 -->
            <div class="training-philosophy-card">

                <div class="training-philosophy-icon child-first-icon">
                    <i class="fa-regular fa-heart"></i>
                </div>

                <h3>Child-First</h3>

                <p>
                    Every decision starts with what's best for the child —
                    their growth, confidence, and enjoyment come before competition.
                </p>

            </div>


            <!-- Card 2 -->
            <div class="training-philosophy-card">

                <div class="training-philosophy-icon goal-icon">
                    <i class="fa-solid fa-bullseye"></i>
                </div>

                <h3>Goal-Oriented</h3>

                <p>
                    We set clear, achievable goals for each child and track
                    progress systematically to ensure continuous development.
                </p>

            </div>


            <!-- Card 3 -->
            <div class="training-philosophy-card">

                <div class="training-philosophy-icon positive-icon">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>

                <h3>Positive Reinforcement</h3>

                <p>
                    We celebrate effort, not just results. Positive feedback
                    builds confidence and keeps children motivated.
                </p>

            </div>


            <!-- Card 4 -->
            <div class="training-philosophy-card">

                <div class="training-philosophy-icon adaptive-icon">
                    <i class="fa-solid fa-person-running"></i>
                </div>

                <h3>Adaptive Methods</h3>

                <p>
                    Our coaches adapt training methods to each child's learning
                    style, ability, and pace — no one-size-fits-all.
                </p>

            </div>

        </div>

    </div>

</section>





<!-- =========================================================
     CONTINUOUS LEARNING & DEVELOPMENT
     ========================================================= -->

<section class="continuous-learning-section">

    <div class="continuous-learning-container">

        <!-- Section Header -->
        <div class="continuous-learning-header">

            <span class="continuous-learning-badge">
                Always Growing
            </span>

            <h2>Continuous Learning &amp; Development</h2>

            <p>
                Our coaches never stop learning — we invest in their growth so they can invest in your children
            </p>

        </div>


        <!-- Learning Cards -->
        <div class="continuous-learning-grid">

            <!-- Card 1 -->
            <div class="continuous-learning-card">

                <div class="continuous-learning-card-top">

                    <div class="continuous-learning-icon training-icon">
                        <i class="fa-solid fa-book-open"></i>
                    </div>

                    <h3>Regular Training Workshops</h3>

                </div>

                <p>
                    Our coaches attend quarterly workshops on the latest coaching
                    techniques, sports science, child psychology, and inclusive education
                    practices. These sessions are led by visiting experts and international
                    trainers, ensuring our team stays at the forefront of sports education.
                </p>

            </div>


            <!-- Card 2 -->
            <div class="continuous-learning-card">

                <div class="continuous-learning-card-top">

                    <div class="continuous-learning-icon certification-icon">
                        <i class="fa-solid fa-award"></i>
                    </div>

                    <h3>Certification Programs</h3>

                </div>

                <p>
                    We sponsor our coaches to pursue advanced certifications from national
                    and international sports bodies. From BCCI cricket coaching levels to FINA
                    swimming certifications and UEFA football licenses, we ensure our team
                    holds the highest credentials in their disciplines.
                </p>

            </div>


            <!-- Card 3 -->
            <div class="continuous-learning-card">

                <div class="continuous-learning-card-top">

                    <div class="continuous-learning-icon science-icon">
                        <i class="fa-solid fa-stethoscope"></i>
                    </div>

                    <h3>Sports Science Integration</h3>

                </div>

                <p>
                    Our coaches work alongside sports scientists, physiotherapists, and
                    nutritionists to apply evidence-based training methods. This
                    interdisciplinary approach ensures children receive physically safe,
                    scientifically sound, and holistically beneficial training.
                </p>

            </div>


            <!-- Card 4 -->
            <div class="continuous-learning-card">

                <div class="continuous-learning-card-top">

                    <div class="continuous-learning-icon mentorship-icon">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                    </div>

                    <h3>Mentorship &amp; Peer Learning</h3>

                </div>

                <p>
                    Senior coaches mentor junior staff, and our entire team participates in
                    weekly peer-learning sessions where they share experiences, discuss
                    challenges, and collaboratively develop better coaching strategies. This
                    culture of shared learning elevates everyone.
                </p>

            </div>

        </div>

    </div>

</section>





